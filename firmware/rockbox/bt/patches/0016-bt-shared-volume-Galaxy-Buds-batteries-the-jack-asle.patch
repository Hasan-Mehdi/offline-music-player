 }
 
+/* a step of the headphones' volume, taken at once (the screen says it now), sent from
+ * the control thread; their answer comes back as the volume they actually set */
+bool bt_volume_step(int dir)
+{
+    int v = bt.abs_vol;
+    if (!bt.on_bt || !bt.abs_ok || v < 0)
+        return false;
+    int s = (v * ABS_STEPS + 63) / 127 + (dir > 0 ? 1 : -1);
+    s = MIN(MAX(s, 0), ABS_STEPS);
+    v = (s * 127 + ABS_STEPS / 2) / ABS_STEPS;
+    bt.abs_vol = v;
+    bt.vol_gen++;
+    bt.absvol_save_at = current_tick + 3 * HZ;
+    post(CMD_ABS_SET, v);
+    return true;
+}
