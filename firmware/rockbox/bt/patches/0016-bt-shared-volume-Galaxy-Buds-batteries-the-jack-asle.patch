+#ifdef HAVE_WIRED_SLEEP
+/* Audio on Bluetooth: nothing goes to the jack. The headphone amp sleeps (shutdown pin,
+ * the output muted first) and the DAC gets no clocks; its supplies and registers stay
+ * as they are. Waking is the second half of audiohw_init's pop-free start. The Bluetooth
+ * service calls this with the DAC's own sink switched away (no DMA running). */
+static bool wired_asleep = false;
+
+void audiohw_wired_sleep(bool sleep)
+{
+    if (sleep == wired_asleep)
+        return;
+    wired_asleep = sleep;
+    if (sleep) {
+        gpio_set_level(GPIO_STEREOSW_MUTE, 1);
+        mdelay(10);
+        gpio_set_level(GPIO_HPAMP_SHDN, 0);
+        aic_enable_i2s_bit_clock(false);
+        aic_enable_i2s_master_clock(false);
+    } else {
+        aic_enable_i2s_master_clock(true);
+        aic_enable_i2s_bit_clock(true);
+        mdelay(10);
+        gpio_set_level(GPIO_HPAMP_SHDN, 1);
+        mdelay(10);
+        gpio_set_level(GPIO_STEREOSW_MUTE, 0);
+    }
+}
+#endif
