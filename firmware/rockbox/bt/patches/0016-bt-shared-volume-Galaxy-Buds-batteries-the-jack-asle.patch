                 st_state = ST_DOWN;
                 st_busy = false;
                 stream_cmd(ESP_A2D_MEDIA_CTRL_CHECK_SRC_RDY);
+                buds_start(bt.peer);
                 changed();
             } else if (s == ESP_A2D_CONNECTION_STATE_DISCONNECTED) {
                 st_state = ST_DOWN;
@@ -811,11 +941,40 @@ static void bt_app_a2d_cb(esp_a2d_cb_event_t event, esp_a2d_cb_param_t *param)
     }
 }
 
+/* AVRCP controller: the volume the headphones share. Ask what they can report; if their
+ * volume is among it, subscribe -- the first answer is where it stands now, then one per
+ * change made on them (re-subscribe each time). */
 static void bt_app_avrc_ct_cb(esp_avrc_ct_cb_event_t event, esp_avrc_ct_cb_param_t *param)
 {
     switch (event) {
         case ESP_AVRC_CT_CONNECTION_STATE_EVT:
             bt_logf("avrc-ct: %s", param->conn_stat.connected ? "up" : "down");
+            if (param->conn_stat.connected)
+                esp_avrc_ct_send_get_rn_capabilities_cmd(TL_CAPS);
+            else
+                post(EV_ABS_GONE, 0);
+            break;
+        case ESP_AVRC_CT_GET_RN_CAPABILITIES_RSP_EVT: {
+            bool vol = esp_avrc_rn_evt_bit_mask_operation(ESP_AVRC_BIT_MASK_OP_TEST,
+                           &param->get_rn_caps_rsp.evt_set, ESP_AVRC_RN_VOLUME_CHANGE);
+            bt_logf("avrc-ct: they report %04x%s", param->get_rn_caps_rsp.evt_set.bits,
+                    vol ? ", their volume among it" : "");
+            if (vol)
+                esp_avrc_ct_send_register_notification_cmd(TL_RN_VOL, ESP_AVRC_RN_VOLUME_CHANGE, 0);
+            break;
+        }
+        case ESP_AVRC_CT_CHANGE_NOTIFY_EVT:
+            if (param->change_ntf.event_id != ESP_AVRC_RN_VOLUME_CHANGE)
+                break;
+            if (param->change_ntf.interim) {
+                post(EV_ABS_FIRST, param->change_ntf.event_parameter.volume & 0x7f);
+            } else {
+                esp_avrc_ct_send_register_notification_cmd(TL_RN_VOL, ESP_AVRC_RN_VOLUME_CHANGE, 0);
+                post(EV_ABS_VOL, param->change_ntf.event_parameter.volume & 0x7f);
+            }
+            break;
+        case ESP_AVRC_CT_SET_ABSOLUTE_VOLUME_RSP_EVT:
+            post(EV_ABS_VOL, param->set_volume_rsp.volume & 0x7f);
             break;
         default:
             break;
@@ -846,6 +1005,14 @@ static void bt_app_avrc_tg_cb(esp_avrc_tg_cb_event_t event, esp_avrc_tg_cb_param
         case ESP_AVRC_PT_CMD_BACKWARD:
             button_queue_post(BUTTON_MULTIMEDIA_PREV, 0);
             break;
+        /* headphones that keep no volume of their own send their volume buttons here:
+         * they are the player's volume keys */
+        case ESP_AVRC_PT_CMD_VOL_UP:
+            button_queue_post(BUTTON_VOL_UP, 0);
+            break;
+        case ESP_AVRC_PT_CMD_VOL_DOWN:
+            button_queue_post(BUTTON_VOL_DOWN, 0);
+            break;
         default:
             break;
     }
@@ -893,8 +1060,11 @@ static bool radio_start(void)
         esp_avrc_psth_bit_mask_operation(ESP_AVRC_BIT_MASK_OP_SET, &psth, ESP_AVRC_PT_CMD_STOP);
         esp_avrc_psth_bit_mask_operation(ESP_AVRC_BIT_MASK_OP_SET, &psth, ESP_AVRC_PT_CMD_FORWARD);
         esp_avrc_psth_bit_mask_operation(ESP_AVRC_BIT_MASK_OP_SET, &psth, ESP_AVRC_PT_CMD_BACKWARD);
+        esp_avrc_psth_bit_mask_operation(ESP_AVRC_BIT_MASK_OP_SET, &psth, ESP_AVRC_PT_CMD_VOL_UP);
+        esp_avrc_psth_bit_mask_operation(ESP_AVRC_BIT_MASK_OP_SET, &psth, ESP_AVRC_PT_CMD_VOL_DOWN);
         esp_avrc_tg_set_psth_cmd_filter(ESP_AVRC_PSTH_FILTER_SUPPORTED_CMD, &psth);
     }
+    buds_radio(true);
 
     if ((ret = esp_a2d_source_init()) != ESP_OK) {
         bt_logf("radio: a2dp init failed %d", ret);
@@ -944,6 +1114,7 @@ static void audio_to_wired(bool pause_it)
         sleep(HZ / 10);         /* let the pause land before the DAC gets the stream */
     }
     st_sink_active = false;
+    audiohw_wired_sleep(false);
     switch_sink(PCM_SINK_BUILTIN);
     volume_to_wired();
     bt_logf("audio: back on wired");
@@ -956,8 +1127,10 @@ static void radio_stop(void)
