+#define ABS_SW_LEVEL    0
+#define ABS_STEPS       16
+#define ABS_FIRST_MAX   64
+enum { TL_CAPS = 1, TL_RN_VOL = 2, TL_SET_VOL = 3 };    /* AVRCP transaction labels */
 
