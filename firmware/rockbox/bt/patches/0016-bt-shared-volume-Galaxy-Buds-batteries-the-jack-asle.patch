                     stream_kick();
                 }
@@ -1142,6 +1320,23 @@ static void ctl_task(void)
             case EV_LINK_DOWN:
                 link_down(ev.data != 0);
                 break;
+            case EV_ABS_FIRST:
+                abs_first(ev.data);
+                break;
+            case EV_ABS_VOL:
+                abs_changed(ev.data);
+                break;
