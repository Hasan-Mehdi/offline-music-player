+/* the headphones started sharing their volume while audio was already on them: from now
+ * on full scale, and the level we had used for them waits for headphones that don't */
+static void abs_pin(void)
+{
+    if (!bt.on_bt || !bt.abs_ok || bt.sw_pinned)
+        return;
+    bt.bt_volume = global_status.volume;
+    bt.sw_pinned = true;
+    global_status.volume = MIN(ABS_SW_LEVEL, global_settings.volume_limit);
+    setvol();
+}
+
+static void abs_unpin(void)
+{
+    if (!bt.sw_pinned)
+        return;
+    bt.sw_pinned = false;
+    if (bt.on_bt) {
+        global_status.volume = MIN(bt.bt_volume, global_settings.volume_limit);
+        setvol();
+    }
+}
+
+static void post(long id, intptr_t data);
+static void abs_changed(int v);
+
+/* each pair keeps its volume (a phone does the same), saved once it stops moving */
+static void abs_save(bool now)
+{
+    if (!bt.absvol_save_at || (!now && !TIME_AFTER(current_tick, bt.absvol_save_at)))
+        return;
+    bt.absvol_save_at = 0;
+    struct known *k = bt.have_peer ? known_find(bt.peer) : NULL;
+    if (k && bt.abs_vol >= 0 && k->absvol != bt.abs_vol) {
+        k->absvol = bt.abs_vol;
+        state_save();
+    }
+}
+
+/* their first answer: where their volume stands. A pair we know goes back to its own
+ * volume with us; a new one keeps its own, but no louder than half way */
+static void abs_first(int theirs)
+{
+    if (bt.link < BT_LINK_CONNECTED)
+        return;
+    if (bt.abs_ok) {                    /* subscribed again: just news */
+        abs_changed(theirs);
+        return;
+    }
+    struct known *k = known_find(bt.peer);
+    int want = k && k->absvol >= 0 ? k->absvol : MIN(theirs, ABS_FIRST_MAX);
+    bt.abs_ok = true;
+    bt.abs_vol = want;
+    if (want != theirs)
+        esp_avrc_ct_send_set_absolute_volume_cmd(TL_SET_VOL, want);
+    abs_pin();
+    bt.vol_gen++;
+    bt_logf("volume: shared with %s, %d%% (theirs was %d%%)", name_of(bt.peer),
+            want * 100 / 127, theirs * 100 / 127);
+    changed();
+}
+
+static void abs_changed(int v)
+{
+    if (!bt.abs_ok || v == bt.abs_vol)
+        return;
+    bt.abs_vol = v;
+    bt.vol_gen++;
+    bt.absvol_save_at = current_tick + 3 * HZ;
+    changed();
+}
+
+static void abs_forget(void)
+{
+    abs_save(true);
+    if (!bt.abs_ok)
+        return;
+    abs_unpin();
+    bt.abs_ok = false;
+    bt.abs_vol = -1;
+    bt.vol_gen++;
+}
+
+/* ------------------------------------------------------------------ the jack, asleep
+ * While audio is on Bluetooth the headphone amp and the DAC have nothing to do (the
+ * player's own audio path, erosqnative audiohw); they wake before the jack plays again. */
+#if defined(HAVE_WIRED_SLEEP) && !defined(SIMULATOR)
+extern void audiohw_wired_sleep(bool sleep);
+#else
+static void audiohw_wired_sleep(bool sleep) { (void)sleep; }
+#endif
