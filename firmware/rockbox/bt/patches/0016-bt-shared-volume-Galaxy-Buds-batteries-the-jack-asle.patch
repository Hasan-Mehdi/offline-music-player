@@ -1265,7 +1480,8 @@ static const char *bt_info_getname(int item, void *data, char *buf, size_t len)
         case 0: snprintf(buf, len, "radio: %s%s", radio_names[bt.radio], bt.scanning ? ", scanning" : ""); break;
         case 1: snprintf(buf, len, "link: %s %s", link_names[bt.link], bt.have_peer ? name_of(bt.peer) : ""); break;
         case 2: snprintf(buf, len, "stream: state %d want %d busy %d sink %d", st_state, st_want, st_busy, st_sink_active); break;
-        case 3: snprintf(buf, len, "rate %lu Hz, volume bt %d wired %d", bt_sampr[0], bt.bt_volume, bt.wired_volume); break;
+        case 3: snprintf(buf, len, "rate %lu Hz, volume bt %d wired %d theirs %d", bt_sampr[0], bt.bt_volume,
+                         bt.wired_volume, bt.abs_ok ? bt.abs_vol : -1); break;
 #ifndef SIMULATOR
         case 4: snprintf(buf, len, "heap %u/%u", (unsigned)get_used_size(btbuf), (unsigned)get_max_size(btbuf)); break;
