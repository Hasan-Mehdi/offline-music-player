+/***************************************************************************
+ *             __________               __   ___.
+ *   Open      \______   \ ____   ____ |  | _\_ |__   _______  ___
+ *   Source     |       _//  _ \_/ ___\|  |/ /| __ \ /  _ \  \/  /
+ *   Jukebox    |    |   (  <_> )  \___|    < | \_\ (  <_> > <  <
+ *   Firmware   |____|_  /\____/ \___  >__|_ \|___  /\____/__/\_ \
+ *                     \/            \/     \/    \/            \/
+ *
+ * Galaxy Buds' batteries. Samsung's buds tell them over a serial channel of their own
+ * (RFCOMM, service 2e73a4ad-332d-41fc-90e2-16bef06523f2), the one Galaxy Wearable talks
+ * to. Its framing, as the open GalaxyBudsClient documents it:
+ *
+ *   FD <header, 16-bit LE: size & 0x3ff, 0x2000 = fragment> <id> <payload> <crc> DD
+ *
+ * size counts id + payload + the CRC (CRC16-CCITT/XMODEM of id + payload, low byte
+ * first). Right after the channel opens the buds send 0x61 "extended status", then 0x60
+ * "status" whenever a battery or where the buds sit changes:
+ *
+ *   0x61  [2] left %  [3] right %  [6] placement (left << 4 | right)  [7] case %
+ *   0x60  [1] left %  [2] right %  [5] placement                      [6] case %
+ *
+ * We only listen, and answer the first message with "manager info" as Galaxy Wearable
+ * does. Headphones without the service: the search finds nothing and that's that.
+ *
+ * RFCOMM through Bluedroid's BTA JV layer (its SPP profile on top needs FreeRTOS ring
+ * buffers and a VFS). JV's callbacks run on Bluedroid's BTU thread; buds_radio, _stop
+ * and _tick on bluetooth.c's control thread; buds_start on the BTC thread.
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License
+ * as published by the Free Software Foundation; either version 2
+ * of the License, or (at your option) any later version.
+ *
+ * This software is distributed on an "AS IS" basis, WITHOUT WARRANTY OF ANY
+ * KIND, either express or implied.
+ *
+ ****************************************************************************/
+#include "common/bt_target.h"
+#include "bta/bta_jv_api.h"
+#include "osi/allocator.h"
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+#include "bluetooth.h"
+#include "kernel.h"
+
+#define START_DELAY (3 * HZ)    /* after the audio link: let A2DP and AVRCP settle first */
+#define RETRY_DELAY (20 * HZ)   /* the search or the channel failed: once more, later */
+#define TRIES       2
+
+/* the service, in the order SDP carries it (big-endian) */
+static const uint8_t SAMSUNG_UUID[16] = {
+    0x2e, 0x73, 0xa4, 0xad, 0x33, 0x2d, 0x41, 0xfc, 0x90, 0xe2, 0x16, 0xbe, 0xf0, 0x65, 0x23, 0xf2,
+};
+
+enum { B_OFF, B_IDLE, B_WAIT, B_SEARCH, B_CONNECT, B_OPEN };
+static volatile int state = B_OFF;
+static bool jv_up;
+static uint8_t peer[6];
+static volatile long start_at;
+static int tries;
+static volatile uint32_t handle;
+
+static volatile int8_t lvl_l = -1, lvl_r = -1, lvl_c = -1;
+unsigned buds_gen;
+
+/* ------------------------------------------------------------------ the messages */
+
+static uint16_t crc16(const uint8_t *p, int n)
+{
+    uint16_t crc = 0;
+    while (n-- > 0) {
+        crc ^= (uint16_t)(*p++) << 8;
+        for (int i = 0; i < 8; i++)
+            crc = crc & 0x8000 ? (uint16_t)(crc << 1) ^ 0x1021 : (uint16_t)(crc << 1);
+    }
+    return crc;
+}
+
+/* "manager info": revision 1, a Samsung phone, Android 14 -- what GalaxyBudsClient sends.
+ * Static: BTA_JvRfcommWrite keeps the pointer until the BTU thread sends it. */
+static uint8_t mgr_msg[10];
+
+static void say_hello(void)
+{
+    static const uint8_t body[4] = { 0x88, 1, 1, 34 };     /* id, payload */
+    int size = (int)sizeof body + 2;
+    uint16_t crc = crc16(body, sizeof body);
+    mgr_msg[0] = 0xfd;
+    mgr_msg[1] = size & 0xff;
+    mgr_msg[2] = size >> 8;
+    memcpy(mgr_msg + 3, body, sizeof body);
+    mgr_msg[7] = crc & 0xff;
+    mgr_msg[8] = crc >> 8;
+    mgr_msg[9] = 0xdd;
+    if (handle)
+        BTA_JvRfcommWrite(handle, 1, sizeof mgr_msg, mgr_msg);
+}
+
+/* a bud that isn't there (placement 0) has no level; neither has a case nobody's in */
+static void levels(int l, int r, int c, int place)
+{
+    int8_t nl = (place >> 4) && l <= 100 ? l : -1;
+    int8_t nr = (place & 15) && r <= 100 ? r : -1;
+    int8_t nc = c > 0 && c <= 100 ? c : -1;
+    if (nl == lvl_l && nr == lvl_r && nc == lvl_c)
+        return;
+    lvl_l = nl;
+    lvl_r = nr;
+    lvl_c = nc;
+    buds_gen++;
+    bt_logf("buds: left %d%%, right %d%%, case %d%% (placement %02x)", nl, nr, nc, place);
+}
+
+static void message(int id, const uint8_t *p, int n)
+{
+    if (id == 0x61 && n >= 8) {
+        levels(p[2], p[3], p[7], p[6]);
+        say_hello();
+    } else if (id == 0x60 && n >= 7) {
+        levels(p[1], p[2], p[6], p[5]);
+    }
+}
+
+static uint8_t rx[512];
+static int rx_n;
+
+static void feed(const uint8_t *p, int n)
+{
+    while (n-- > 0) {
+        uint8_t b = *p++;
+        if (rx_n == 0 && b != 0xfd)
+            continue;                           /* hunting for the start */
+        rx[rx_n++] = b;
+        if (rx_n < 3)
+            continue;
+        int hdr = rx[1] | rx[2] << 8, size = hdr & 0x3ff, total = size + 4;
+        if (size < 3 || total > (int)sizeof rx) {
+            rx_n = 0;
+            continue;
+        }
+        if (rx_n < total)
+            continue;
+        const uint8_t *m = rx + 3;              /* id, payload, crc */
+        uint16_t crc = m[size - 2] | m[size - 1] << 8;
+        if (rx[total - 1] == 0xdd && !(hdr & 0x2000) && crc16(m, size - 2) == crc)
+            message(m[0], m + 1, size - 3);
+        rx_n = 0;
+    }
+}
+
+/* ------------------------------------------------------------------ RFCOMM, BTU thread */
+
+/* JV's call-outs for connections that use them (all of JV's RFCOMM ones): incoming data
+ * is ours to free, and the buds get a credit back for each piece */
+int bta_co_rfc_data_incoming(void *user_data, BT_HDR *p_buf)
+{
+    (void)user_data;
+    feed((const uint8_t *)(p_buf + 1) + p_buf->offset, p_buf->len);
+    osi_free(p_buf);
+    if (handle)
+        BTA_JvRfcommFlowControl(handle, 1);
+    return 1;
+}
+
+int bta_co_rfc_data_outgoing_size(void *user_data, int *size)
+{
+    (void)user_data; (void)size;
+    return 1;
+}
+
+int bta_co_rfc_data_outgoing(void *user_data, uint8_t *buf, uint16_t size)
+{
+    (void)user_data; (void)buf; (void)size;
+    return 1;
+}
+
+static void *rfc_cb(tBTA_JV_EVT event, tBTA_JV *p_data, void *user_data)
+{
+    (void)user_data;
+    switch (event) {
+        case BTA_JV_RFCOMM_CL_INIT_EVT:
+            if (p_data->rfc_cl_init.status == BTA_JV_SUCCESS)
+                handle = p_data->rfc_cl_init.handle;
+            break;
+        case BTA_JV_RFCOMM_OPEN_EVT:
+            if (p_data->rfc_open.status == BTA_JV_SUCCESS) {
+                handle = p_data->rfc_open.handle;
+                rx_n = 0;
+                state = B_OPEN;
+                bt_logf("buds: channel open");
+            }
+            break;
+        case BTA_JV_RFCOMM_CLOSE_EVT:
+            bt_logf("buds: channel closed (%d)", (int)p_data->rfc_close.port_status);
+            handle = 0;
+            if (state == B_CONNECT || state == B_OPEN) {
+                /* never opened: try again later; closed after: the link went with it */
+                state = state == B_CONNECT && tries < TRIES ? B_WAIT : B_IDLE;
+                start_at = current_tick + RETRY_DELAY;
+            }
+            break;
+        default:
+            break;
+    }
+    return NULL;
+}
+
+static void dm_cb(tBTA_JV_EVT event, tBTA_JV *p_data, void *user_data)
+{
+    (void)user_data;
+    switch (event) {
+        case BTA_JV_ENABLE_EVT:
+            if (p_data->status != BTA_JV_SUCCESS)
+                bt_logf("buds: rfcomm didn't start (%d)", p_data->status);
+            break;
+        case BTA_JV_DISCOVERY_COMP_EVT: {
+            if (state != B_SEARCH)
+                break;
+            tBTA_JV_DISCOVERY_COMP *d = &p_data->disc_comp;
+            if (d->status != BTA_JV_SUCCESS || d->scn_num == 0) {
+                /* not Galaxy Buds (or the search failed: once more if it might have) */
+                bt_logf("buds: no Samsung channel (status %d)", d->status);
+                state = d->status != BTA_JV_SUCCESS && tries < TRIES ? B_WAIT : B_IDLE;
+                start_at = current_tick + RETRY_DELAY;
+                break;
+            }
+            bt_logf("buds: Samsung channel %d", d->scn[0]);
+            state = B_CONNECT;
+            if (BTA_JvRfcommConnect(BTA_SEC_AUTHENTICATE, BTA_JV_ROLE_MASTER, d->scn[0], peer,
+                                    rfc_cb, NULL) != BTA_JV_SUCCESS) {
+                state = B_IDLE;
+            }
+            break;
+        }
+        default:
+            break;
+    }
+}
+
+/* ------------------------------------------------------------------ control thread */
+
+void buds_radio(bool on)
+{
+    if (on && !jv_up) {
+        jv_up = BTA_JvEnable(dm_cb) == BTA_JV_SUCCESS;
+        state = B_IDLE;
+    } else if (!on && jv_up) {
+        buds_stop();
+        BTA_JvDisable(NULL);
+        jv_up = false;
+        state = B_OFF;
+    }
+}
+
+/* Bluedroid's thread: just note it, the control thread starts the search */
+void buds_start(const uint8_t addr[6])
+{
+    if (state == B_OFF)
+        return;
+    memcpy(peer, addr, 6);
+    tries = 0;
+    start_at = current_tick + START_DELAY;
+    state = B_WAIT;
+}
+
+void buds_stop(void)
+{
+    if (handle)
+        BTA_JvRfcommClose(handle, NULL);
+    handle = 0;
+    if (state != B_OFF)
+        state = B_IDLE;
+    if (lvl_l >= 0 || lvl_r >= 0 || lvl_c >= 0) {
+        lvl_l = lvl_r = lvl_c = -1;
+        buds_gen++;
+    }
+}
+
+void buds_tick(void)
+{
+    if (state != B_WAIT || !TIME_AFTER(current_tick, start_at))
+        return;
+    tSDP_UUID uuid;
+    memset(&uuid, 0, sizeof uuid);
+    uuid.len = 16;
+    memcpy(uuid.uu.uuid128, SAMSUNG_UUID, 16);
+    tries++;
+    state = B_SEARCH;
+    if (BTA_JvStartDiscovery(peer, 1, &uuid, NULL) != BTA_JV_SUCCESS)
+        state = B_IDLE;
+}
+
+void buds_get(int8_t *l, int8_t *r, int8_t *c)
+{
+    *l = lvl_l;
+    *r = lvl_r;
+    *c = lvl_c;
+}
