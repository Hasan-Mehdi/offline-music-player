-extern void uart_tx(uart_port_t port, const uint8_t *buf, size_t len);
+/* false if the remote held CTS off for over a second (bytes were dropped) */
+extern bool uart_tx(uart_port_t port, const uint8_t *buf, size_t len);
+/* Blocks until at least one byte is available, returns how many were read
+ * (up to len). uart_rx_tmo returns 0 if nothing arrived within timeout ticks
+ * (TIMEOUT_NOBLOCK polls, TIMEOUT_BLOCK waits forever). */
 extern size_t uart_rx(uart_port_t port, uint8_t *buf, size_t len);
+extern size_t uart_rx_tmo(uart_port_t port, uint8_t *buf, size_t len, int timeout);
+/* hardware RX FIFO overruns seen since uart_init (should stay 0 with RTS/CTS) */
+extern unsigned uart_rx_overruns(uart_port_t port);
 extern bool uart_pending_rx(uart_port_t port);
 extern void uart_set_baud(uart_port_t port, int baud);
 extern void uart_deinit(uart_port_t port);
