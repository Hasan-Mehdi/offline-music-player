+              + (((p->s16ChannelMode - 2) * p->s16NumOfSubBands) + (p->s16NumOfBlocks * bp)) / 8;
+        br = (8 * len * fs) / (p->s16NumOfSubBands * p->s16NumOfBlocks * 1000);
+        if (br > rate) {
+            bp--;
+        }
