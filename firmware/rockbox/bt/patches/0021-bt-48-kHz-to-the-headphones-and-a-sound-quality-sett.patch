diff --git a/lib/bluedroid/src/btc/profile/std/a2dp/bta_av_co.c b/lib/bluedroid/src/btc/profile/std/a2dp/bta_av_co.c
index 069f7d9a..de09df7c 100644
--- a/lib/bluedroid/src/btc/profile/std/a2dp/bta_av_co.c
+++ b/lib/bluedroid/src/btc/profile/std/a2dp/bta_av_co.c
@@ -64,13 +64,16 @@
 #define BTA_AV_CO_SBC_MAX_BITPOOL_OFF  6
 
 #define BTA_AV_CO_SBC_MAX_BITPOOL  53
+/* coda: dual channel spends the bitpool on each channel: 38 is "SBC XQ" (~492 kbps at
+ * 48 kHz, ~452 at 44.1), four frames to a 2 Mbit EDR packet */
+#define BTA_AV_CO_SBC_DUAL_MAX_BITPOOL  38
 
 /* SCMS-T protect info */
 const UINT8 bta_av_co_cp_scmst[BTA_AV_CP_INFO_LEN] =  { 2, 2, 0 };
 
 /* SBC SRC codec capabilities */
 const tA2D_SBC_CIE bta_av_co_sbc_caps = {
-    (A2D_SBC_IE_SAMP_FREQ_44), /* samp_freq */
+    (A2D_SBC_IE_SAMP_FREQ_48 | A2D_SBC_IE_SAMP_FREQ_44), /* samp_freq (coda: + 48 kHz) */
     (A2D_SBC_IE_CH_MD_MONO | A2D_SBC_IE_CH_MD_STEREO | A2D_SBC_IE_CH_MD_JOINT | A2D_SBC_IE_CH_MD_DUAL), /* ch_mode */
     (A2D_SBC_IE_BLOCKS_16 | A2D_SBC_IE_BLOCKS_12 | A2D_SBC_IE_BLOCKS_8 | A2D_SBC_IE_BLOCKS_4), /* block_len */
     (A2D_SBC_IE_SUBBAND_4 | A2D_SBC_IE_SUBBAND_8), /* num_subbands */
@@ -105,6 +108,94 @@ const tA2D_SBC_CIE btc_av_sbc_default_config = {
     A2D_SBC_IE_MIN_BITPOOL          /* min_bitpool */
 };
 
+/* coda: the quality setting (bluetooth.c): dual channel instead of joint stereo */
+static volatile UINT8 bta_av_co_sbc_high;
+
+void bta_av_co_audio_set_sbc_quality(BOOLEAN high)
+{
+    bta_av_co_sbc_high = high ? 1 : 0;
+}
+
+/* coda: the SBC link a sink gets, from what it says it takes: 48 kHz when it can (the
+ * music is 48 kHz Opus, so nothing gets resampled), dual channel in the high setting, else
+ * joint stereo; 16 blocks, 8 subbands and loudness when it has them; its bitpool range
+ * inside ours. ESP-IDF instead offered its one default (44.1 kHz joint stereo) to every
+ * sink. FALSE: nothing in common. */
+static BOOLEAN bta_av_co_sbc_cfg_for_sink(const UINT8 *p_codec_caps, UINT8 *p_codec_cfg)
+{
+    tA2D_SBC_CIE caps;
+    tA2D_SBC_CIE cfg = btc_av_sbc_default_config;
+    UINT8 freq, max_bitpool;
+    tA2D_STATUS status = A2D_ParsSbcInfo(&caps, (UINT8 *)p_codec_caps, TRUE);
+
+    /* a bitpool range outside the spec's 2..250 is clamped below, as the copy-the-config
+     * code always did, rather than turning the sink away */
+    if (status != A2D_SUCCESS && status != A2D_BAD_MIN_BITPOOL && status != A2D_BAD_MAX_BITPOOL) {
+        return FALSE;
+    }
+
+    freq = caps.samp_freq & bta_av_co_sbc_caps.samp_freq;
+    if (freq & A2D_SBC_IE_SAMP_FREQ_48) {
+        cfg.samp_freq = A2D_SBC_IE_SAMP_FREQ_48;
+    } else if (freq & A2D_SBC_IE_SAMP_FREQ_44) {
+        cfg.samp_freq = A2D_SBC_IE_SAMP_FREQ_44;
+    } else {
+        return FALSE;
+    }
+
+    if (bta_av_co_sbc_high && (caps.ch_mode & A2D_SBC_IE_CH_MD_DUAL)) {
+        cfg.ch_mode = A2D_SBC_IE_CH_MD_DUAL;
+    } else if (caps.ch_mode & A2D_SBC_IE_CH_MD_JOINT) {
+        cfg.ch_mode = A2D_SBC_IE_CH_MD_JOINT;
+    } else if (caps.ch_mode & A2D_SBC_IE_CH_MD_STEREO) {
+        cfg.ch_mode = A2D_SBC_IE_CH_MD_STEREO;
+    } else if (caps.ch_mode & A2D_SBC_IE_CH_MD_DUAL) {
+        cfg.ch_mode = A2D_SBC_IE_CH_MD_DUAL;
+    } else if (caps.ch_mode & A2D_SBC_IE_CH_MD_MONO) {
+        cfg.ch_mode = A2D_SBC_IE_CH_MD_MONO;
+    } else {
+        return FALSE;
+    }
+
+    if (caps.block_len & A2D_SBC_IE_BLOCKS_16) {
+        cfg.block_len = A2D_SBC_IE_BLOCKS_16;
+    } else if (caps.block_len & A2D_SBC_IE_BLOCKS_12) {
+        cfg.block_len = A2D_SBC_IE_BLOCKS_12;
+    } else if (caps.block_len & A2D_SBC_IE_BLOCKS_8) {
+        cfg.block_len = A2D_SBC_IE_BLOCKS_8;
+    } else if (caps.block_len & A2D_SBC_IE_BLOCKS_4) {
+        cfg.block_len = A2D_SBC_IE_BLOCKS_4;
+    } else {
+        return FALSE;
+    }
+
+    if (caps.num_subbands & A2D_SBC_IE_SUBBAND_8) {
+        cfg.num_subbands = A2D_SBC_IE_SUBBAND_8;
+    } else if (caps.num_subbands & A2D_SBC_IE_SUBBAND_4) {
+        cfg.num_subbands = A2D_SBC_IE_SUBBAND_4;
+    } else {
+        return FALSE;
+    }
+
+    if (caps.alloc_mthd & A2D_SBC_IE_ALLOC_MD_L) {
+        cfg.alloc_mthd = A2D_SBC_IE_ALLOC_MD_L;
+    } else if (caps.alloc_mthd & A2D_SBC_IE_ALLOC_MD_S) {
+        cfg.alloc_mthd = A2D_SBC_IE_ALLOC_MD_S;
+    } else {
+        return FALSE;
+    }
+
+    max_bitpool = (cfg.ch_mode == A2D_SBC_IE_CH_MD_DUAL) ? BTA_AV_CO_SBC_DUAL_MAX_BITPOOL
+                                                         : BTA_AV_CO_SBC_MAX_BITPOOL;
+    cfg.min_bitpool = BTA_AV_CO_MAX(caps.min_bitpool, A2D_SBC_IE_MIN_BITPOOL);
+    cfg.max_bitpool = BTA_AV_CO_MIN(caps.max_bitpool, max_bitpool);
+    if (cfg.min_bitpool > cfg.max_bitpool) {
+        return FALSE;
+    }
+
+    return A2D_BldSbcInfo(AVDT_MEDIA_AUDIO, &cfg, p_codec_cfg) == A2D_SUCCESS;
+}
+
