-                                          ESP_A2D_SBC_CIE_SF_48K : ESP_A2D_SBC_CIE_SF_44K;
-            pref.cie.sbc_info.ch_mode = (c->ch_mode & ESP_A2D_SBC_CIE_CH_MODE_JOINT_STEREO) ?
-                                        ESP_A2D_SBC_CIE_CH_MODE_JOINT_STEREO : ESP_A2D_SBC_CIE_CH_MODE_STEREO;
-            pref.cie.sbc_info.block_len = ESP_A2D_SBC_CIE_BLOCK_LEN_16;
-            pref.cie.sbc_info.num_subbands = ESP_A2D_SBC_CIE_NUM_SUBBANDS_8;
-            pref.cie.sbc_info.alloc_mthd = ESP_A2D_SBC_CIE_ALLOC_MTHD_LOUDNESS;
-            pref.cie.sbc_info.min_bitpool = MAX(c->min_bitpool, 2);
-            /* 53 = the "high quality" profile (~328 kbps at 44.1 joint stereo) */
-            pref.cie.sbc_info.max_bitpool = c->max_bitpool ? MIN(c->max_bitpool, 53) : 53;
-            esp_err_t ret = esp_a2d_source_set_pref_mcc(param->a2d_report_snk_codec_caps_stat.conn_hdl, &pref);
-            if (ret != ESP_OK)
-                bt_logf("a2dp: set_pref_mcc failed %d", ret);
             break;
         }
         case ESP_A2D_AUDIO_CFG_EVT: {
             const esp_a2d_cie_sbc_t *c = &param->audio_cfg.mcc.cie.sbc_info;
             if (param->audio_cfg.mcc.type == ESP_A2D_MCT_SBC) {
                 bt_sampr[0] = (c->samp_freq & ESP_A2D_SBC_CIE_SF_48K) ? SAMPR_48 : SAMPR_44;
-                bt_logf("a2dp: configured sbc %lu Hz, bitpool %d-%d", bt_sampr[0],
-                        c->min_bitpool, c->max_bitpool);
+                bt.link_hz = bt_sampr[0];
+                bt.link_kbps = sbc_kbps(c);
+                bt_logf("a2dp: configured sbc %lu Hz %s, bitpool %d-%d (%u kbps)", bt_sampr[0],
+                        sbc_mode_name(c->ch_mode), c->min_bitpool, c->max_bitpool, bt.link_kbps);
+                changed();
             }
             break;
         }
@@ -1339,8 +1371,6 @@ fail_hci:
     return false;
 }
 
