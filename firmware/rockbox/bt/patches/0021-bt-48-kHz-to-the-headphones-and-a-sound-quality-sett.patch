+/* ------------------------------------------------------------------ sound quality
+ * Standard: SBC joint stereo, bitpool up to 53 (~350 kbps at 48 kHz). High: dual channel,
+ * each channel its own bitpool up to 38 (~490 kbps, "SBC XQ"): cymbals and reverb tails
+ * keep their detail, for more radio time (battery, and range when it's crowded). The
+ * stack picks the config as headphones connect (bta_av_co.c); a change while connected
+ * reconfigures the link when the stream starts next. */
+extern uint16_t btm_get_max_packet_size(uint8_t *addr);   /* Bluedroid's btm_acl.c */
+extern void bta_av_co_audio_set_sbc_quality(uint8_t high);
+
+static const char *sbc_mode_name(int ch_mode)
+{
+    return ch_mode & ESP_A2D_SBC_CIE_CH_MODE_DUAL_CHANNEL ? "dual channel" :
+           ch_mode & ESP_A2D_SBC_CIE_CH_MODE_JOINT_STEREO ? "joint stereo" :
+           ch_mode & ESP_A2D_SBC_CIE_CH_MODE_STEREO ? "stereo" : "mono";
+}
+
+/* what the encoder sends: it aims at the top of the bitpool range (no more than 229 kbps
+ * on a basic rate link, btc_a2dp_source.c) */
+static unsigned sbc_kbps(const esp_a2d_cie_sbc_t *c)
+{
+    unsigned fs = c->samp_freq & ESP_A2D_SBC_CIE_SF_48K ? 48000 : c->samp_freq & ESP_A2D_SBC_CIE_SF_44K ? 44100 :
+                  c->samp_freq & ESP_A2D_SBC_CIE_SF_32K ? 32000 : 16000;
+    unsigned blocks = c->block_len & ESP_A2D_SBC_CIE_BLOCK_LEN_16 ? 16 : c->block_len & ESP_A2D_SBC_CIE_BLOCK_LEN_12 ? 12 :
+                      c->block_len & ESP_A2D_SBC_CIE_BLOCK_LEN_8 ? 8 : 4;
+    unsigned sb = c->num_subbands & ESP_A2D_SBC_CIE_NUM_SUBBANDS_8 ? 8 : 4;
+    unsigned ch = c->ch_mode & ESP_A2D_SBC_CIE_CH_MODE_MONO ? 1 : 2;
+    unsigned bp = c->max_bitpool, bits;
+    if (c->ch_mode & ESP_A2D_SBC_CIE_CH_MODE_DUAL_CHANNEL)
+        bits = blocks * 2 * bp;
+    else if (c->ch_mode & ESP_A2D_SBC_CIE_CH_MODE_JOINT_STEREO)
+        bits = sb + blocks * bp;
+    else
+        bits = blocks * bp;
+    unsigned frame = 4 + (4 * sb * ch) / 8 + (bits + 7) / 8;     /* bytes */
+    unsigned kbps = (8 * frame * fs / (sb * blocks) + 500) / 1000;
+    if (bt.have_peer && btm_get_max_packet_size(bt.peer) == 339)  /* DH5: basic rate */
+        kbps = MIN(kbps, 229);
+    return kbps;
+}
+
