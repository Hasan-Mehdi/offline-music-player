+static UINT16 btc_a2dp_source_rate_for_bitpool(const SBC_ENC_PARAMS *p, UINT16 fs, UINT8 bitpool)
+{
+    UINT16 rate;
+    if (p->s16NumOfBlocks == 0 || p->s16NumOfSubBands == 0 || p->s16NumOfChannels == 0) {
+        return DEFAULT_SBC_BITRATE;
+    }
+    for (rate = 16; rate < 1500 && btc_a2dp_source_sbc_bitpool(p, fs, rate) < bitpool; rate++) {
+    }
+    return rate;
+}
