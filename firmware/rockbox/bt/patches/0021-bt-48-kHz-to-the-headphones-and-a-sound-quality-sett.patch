+        bp = (SINT16)(((p->s16NumOfSubBands * rate * 1000) / (fs * p->s16NumOfChannels))
+                      - (((32 / p->s16NumOfChannels) + (4 * p->s16NumOfSubBands)) / p->s16NumOfBlocks));
