@@ -1665,6 +1704,7 @@ void bluetooth_init(void)
 {
     log_open();
     state_load();
+    bta_av_co_audio_set_sbc_quality(bt.hq);
     /* we went down with audio on Bluetooth: give wired its own volume back */
     if (bt.on_bt) {
         global_status.volume = bt.wired_volume;
@@ -1725,6 +1765,14 @@ void bt_set_scan(bool on)
     post(CMD_SCAN, on);
 }
 
+void bt_set_quality(bool high)
+{
+    bt.hq = high;
+    state_save();
+    changed();
+    post(CMD_QUALITY, high);
+}
+
 void bt_connect(const uint8_t addr[6])
 {
     memcpy(cmd_connect_addr, addr, 6);
@@ -1770,6 +1818,9 @@ void bt_get_status(struct bt_status *st)
     st->abs_volume = bt.on_bt && bt.abs_ok ? bt.abs_vol : -1;
     st->vol_gen = bt.vol_gen;
     buds_get(&st->batt_l, &st->batt_r, &st->batt_case);
+    st->hq = bt.hq;
+    st->link_hz = bt.link >= BT_LINK_CONNECTED ? bt.link_hz : 0;
+    st->link_kbps = bt.link >= BT_LINK_CONNECTED ? bt.link_kbps : 0;
     st->gen = bt.gen + buds_gen;
 }
 
