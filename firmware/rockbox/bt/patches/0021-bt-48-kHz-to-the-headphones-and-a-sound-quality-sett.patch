+/* coda: the bitpool btc_a2dp_source_enc_update's search (and SBC_Encoder_Init) derive
+ * from a target rate in kbps -- the same integer arithmetic */
+static SINT16 btc_a2dp_source_sbc_bitpool(const SBC_ENC_PARAMS *p, UINT16 fs, UINT16 rate)
+{
+    SINT16 bp, len, br;
+    if (p->s16ChannelMode == SBC_JOINT_STEREO || p->s16ChannelMode == SBC_STEREO) {
+        bp = (SINT16)((rate * p->s16NumOfSubBands * 1000 / fs)
+                      - ((32 + (4 * p->s16NumOfSubBands * p->s16NumOfChannels)
+                          + ((p->s16ChannelMode - 2) * p->s16NumOfSubBands)) / p->s16NumOfBlocks));
