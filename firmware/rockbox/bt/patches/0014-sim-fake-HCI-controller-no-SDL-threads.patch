From 59e4384b3fafa73f74b9a5e33bb0345caf3976bc Mon Sep 17 00:00:00 2001
From: Hasan Mehdi <hasanthemehdi@gmail.com>
Date: Sun, 11 Oct 2026 10:38:49 -0400
Subject: [PATCH 14/15] sim: fake HCI controller (no SDL threads)

Enough of a BR/EDR controller for the real Bluedroid stack to start, run a
search (three headphones plus a phone the service must filter out) and
fail a connection with a page timeout. BT_FAKE_TRACE=1 logs commands.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 uisimulator/common/hci-sim.c | 216 ++++++++++++++++++++++++++++++++++-
 1 file changed, 211 insertions(+), 5 deletions(-)

diff --git a/uisimulator/common/hci-sim.c b/uisimulator/common/hci-sim.c
index e1991a74..87e8ba9b 100644
--- a/uisimulator/common/hci-sim.c
+++ b/uisimulator/common/hci-sim.c
@@ -246,21 +246,227 @@ void bt_hci_disable(void)
 }
 
 #else /* !HAVE_SDL_THREADS */
+#include <stdlib.h>
 #include <stdbool.h>
 #include <stddef.h>
+#include <string.h>
 #include "bt_hci.h"
+#include "esp_bluedroid_hci.h"
+#include "kernel.h"
+#include "thread.h"
+
+/* Without SDL threads a blocking read on a real controller's tty would stall every
+ * thread, so this simulator talks to a fake controller instead: enough of one for the
+ * real Bluedroid stack to come up, find three headphones (and a phone, which the
+ * service must filter out) in a search, and fail a connection with a page timeout. */
+
+#define FAKE_SLOTS 48
+static struct { long at; uint16_t len; uint8_t tag; uint8_t pkt[260]; } fake_q[FAKE_SLOTS];
+static const esp_bluedroid_hci_driver_callbacks_t *fake_cb;
+static volatile bool fake_stop;
+static unsigned int fake_thread;
+static long fake_stack[(DEFAULT_STACK_SIZE * 2) / sizeof(long)];
+
+static const struct { uint8_t addr[6]; uint32_t cod; int8_t rssi; const char *name; } fake_dev[] = {
+    { { 0x38, 0x18, 0x4c, 0x11, 0x22, 0x33 }, 0x240404, -52, "WH-1000XM4" },
+    { { 0x70, 0xbf, 0x92, 0x44, 0x55, 0x66 }, 0x240404, -64, "Jabra Elite 75t" },
+    { { 0x04, 0x52, 0xc7, 0x77, 0x88, 0x99 }, 0x240414, -71, "KEF Mu3" },
+    { { 0xa4, 0x77, 0x33, 0x01, 0x02, 0x03 }, 0x5a020c, -58, "Pixel 9" },   /* a phone */
+};
+#define FAKE_DEVS (int)(sizeof fake_dev / sizeof fake_dev[0])
+
+static void fake_push(long delay, const uint8_t *pkt, size_t len, int tag)
+{
+    for (int i = 0; i < FAKE_SLOTS; i++) {
+        if (fake_q[i].len == 0) {
+            memcpy(fake_q[i].pkt, pkt, len);
+            fake_q[i].at = current_tick + delay;
+            fake_q[i].tag = tag;
+            fake_q[i].len = len;
+            return;
+        }
+    }
+    bt_logf("fake hci: queue full");
+}
+
+static void fake_cc(uint16_t op, const uint8_t *ret, size_t n)
+{
+    uint8_t p[260] = { 0x04, 0x0e, (uint8_t)(3 + n), 0x01, op & 0xff, op >> 8 };
+    memcpy(p + 6, ret, n);
+    fake_push(1, p, 6 + n, 0);
+}
+
+static void fake_cs(uint16_t op, uint8_t status)
+{
+    uint8_t p[] = { 0x04, 0x0f, 0x04, status, 0x01, op & 0xff, op >> 8 };
+    fake_push(1, p, sizeof p, 0);
+}
+
+static void put_addr(uint8_t *o, const uint8_t a[6])
+{
+    for (int i = 0; i < 6; i++) o[i] = a[5 - i];      /* HCI is little-endian */
+}
+
+static void fake_inquiry(void)
+{
+    static const long at[FAKE_DEVS] = { HZ * 8 / 10, HZ * 16 / 10, HZ * 25 / 10, HZ * 3 };
+    for (int d = 0; d < FAKE_DEVS; d++) {
+        uint8_t p[258] = { 0x04, 0x2f, 0xff, 0x01 };
+        put_addr(p + 4, fake_dev[d].addr);
+        p[10] = 1;
+        p[12] = fake_dev[d].cod & 0xff;
+        p[13] = (fake_dev[d].cod >> 8) & 0xff;
+        p[14] = fake_dev[d].cod >> 16;
+        p[17] = (uint8_t)fake_dev[d].rssi;
+        size_t nl = strlen(fake_dev[d].name);
+        p[18] = nl + 1;
+        p[19] = 0x09;                                  /* complete local name */
+        memcpy(p + 20, fake_dev[d].name, nl);
+        fake_push(at[d], p, 258, 1);
+    }
+    uint8_t done[] = { 0x04, 0x01, 0x01, 0x00 };
+    fake_push(HZ * 4, done, sizeof done, 1);
+}
+
+static void fake_send(uint8_t *data, uint16_t len)
+{
+    if (len < 4 || data[0] != 0x01)
+        return;                                        /* no links, so no ACL either */
+    uint16_t op = data[1] | (data[2] << 8);
+    if (getenv("BT_FAKE_TRACE"))
+        bt_logf("fake hci: cmd %04x len %d", op, data[3]);
+    uint8_t r[249];
+    memset(r, 0, sizeof r);
+    switch (op) {
+        case 0x1005: {                                 /* Read_Buffer_Size */
+            const uint8_t v[] = { 0, 0xfd, 0x03, 64, 8, 0, 1, 0 };
+            fake_cc(op, v, sizeof v);
+            return;
+        }
+        case 0x1001: {                                 /* Read_Local_Version_Information */
+            const uint8_t v[] = { 0, 7, 0, 0, 7, 0x0f, 0, 0, 0 };
+            fake_cc(op, v, sizeof v);
+            return;
+        }
+        case 0x1009: {                                 /* Read_BD_ADDR */
+            const uint8_t a[6] = { 0x00, 0xc0, 0xda, 0x0b, 0x7e, 0x55 };
+            put_addr(r + 1, a);
+            fake_cc(op, r, 7);
+            return;
+        }
+        case 0x1002:                                   /* Read_Local_Supported_Commands */
+            memset(r + 1, 0xff, 64);
+            fake_cc(op, r, 65);
+            return;
+        case 0x1003:                                   /* features: BR/EDR, SSP, no LE */
+        case 0x1004: {
+            static const uint8_t f[8] = { 0xff, 0xff, 0x8f, 0xfe, 0x9b, 0xff, 0x59, 0x83 };
+            if (op == 0x1003) {
+                memcpy(r + 1, f, 8);
+                fake_cc(op, r, 9);
+                return;
+            }
+            r[1] = data[4];                            /* page */
+            r[2] = 1;                                  /* max page */
+            if (data[4] == 0)
+                memcpy(r + 3, f, 8);
+            fake_cc(op, r, 11);
+            return;
+        }
+        case 0x0c14:                                   /* Read_Local_Name */
+            strcpy((char *)r + 1, "Coda (sim)");
+            fake_cc(op, r, 249);
+            return;
+        case 0x0401:                                   /* Inquiry */
+            fake_cs(op, 0);
+            fake_inquiry();
+            return;
+        case 0x0402:                                   /* Inquiry_Cancel */
+            for (int i = 0; i < FAKE_SLOTS; i++)
+                if (fake_q[i].tag == 1)
+                    fake_q[i].len = 0;
+            fake_cc(op, r, 1);
+            return;
+        case 0x0405: {                                 /* Create_Connection: nobody answers */
+            fake_cs(op, 0);
+            uint8_t p[] = { 0x04, 0x03, 0x0b, 0x04 /* page timeout */, 0, 0,
+                            data[4], data[5], data[6], data[7], data[8], data[9], 0x01, 0x00 };
+            fake_push(HZ * 3 / 2, p, sizeof p, 0);
+            return;
+        }
+        case 0x0419: {                                 /* Remote_Name_Request */
+            fake_cs(op, 0);
+            uint8_t p[258] = { 0x04, 0x07, 0xff, 0x00 };
+            memcpy(p + 4, data + 4, 6);
+            for (int d = 0; d < FAKE_DEVS; d++) {
+                uint8_t a[6];
+                put_addr(a, fake_dev[d].addr);
+                if (!memcmp(a, data + 4, 6))
+                    strcpy((char *)p + 10, fake_dev[d].name);
+            }
+            fake_push(HZ / 5, p, 258, 0);
+            return;
+        }
+        default:
+            if ((op >> 10) == 0x01 && op != 0x040b && op != 0x040c && op != 0x040d &&
+                op != 0x040e && op != 0x042b && op != 0x042c && op != 0x042d)
+                fake_cs(op, 0);                        /* link control: status first */
+            else
+                fake_cc(op, r, 65);                    /* success, zeroed return values */
+            return;
+    }
+}
+
+static bool fake_send_available(void)
+{
+    return true;
+}
+
+static esp_err_t fake_register(const esp_bluedroid_hci_driver_callbacks_t *cb)
+{
+    fake_cb = cb;
+    return ESP_OK;
+}
+
+static void fake_task(void)
+{
+    while (!fake_stop) {
+        sleep(1);
+        for (int i = 0; i < FAKE_SLOTS && !fake_stop; i++) {
+            if (fake_q[i].len && fake_cb && TIME_AFTER(current_tick, fake_q[i].at)) {
+                uint8_t pkt[260];
+                uint16_t len = fake_q[i].len;
+                memcpy(pkt, fake_q[i].pkt, len);
+                fake_q[i].len = 0;
+                fake_cb->notify_host_recv(pkt, len);
+            }
+        }
+    }
+}
 
-/* Without SDL threads a blocking read on the controller tty would stall every
- * thread, so this simulator has no controller: Bluetooth fails to start,
- * which still exercises the UI around it. */
 bool bt_hci_enable(void)
 {
-    bt_logf("hci: no controller in this simulator build");
-    return false;
+    bt_logf("hci: fake controller (simulator)");
+    memset(fake_q, 0, sizeof fake_q);
+    fake_cb = NULL;
+    fake_stop = false;
+    esp_bluedroid_hci_driver_operations_t ops = {
+        .send = fake_send,
+        .check_send_available = fake_send_available,
+        .register_host_callback = fake_register,
+    };
+    esp_bluedroid_attach_hci_driver(&ops);
+    fake_thread = create_thread(fake_task, fake_stack, sizeof fake_stack, 0, "bt_fake"
+                                IF_PRIO(, PRIORITY_BLUETOOTH));
+    return fake_thread != 0;
 }
 
 void bt_hci_disable(void)
 {
+    fake_stop = true;
+    if (fake_thread)
+        thread_wait(fake_thread);
+    fake_thread = 0;
 }
 
 #endif
-- 
2.43.0

