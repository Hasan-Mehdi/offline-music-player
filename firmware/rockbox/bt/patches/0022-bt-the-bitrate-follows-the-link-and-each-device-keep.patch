-                bt_logf("a2dp: stopped after %ld s, %u short ticks", (current_tick - st_started_at) / HZ,
-                        st_short - st_short0);
+                bt_logf("a2dp: stopped after %ld s, %u short ticks, %lu packets dropped",
+                        (current_tick - st_started_at) / HZ, st_short - st_short0,
+                        (unsigned long)(coda_a2dp_drops - st_drops0));
             break;
         default:
             break;
@@ -780,6 +798,20 @@ static void fake_sink_start(void)
 extern uint16_t btm_get_max_packet_size(uint8_t *addr);   /* Bluedroid's btm_acl.c */
 extern void bta_av_co_audio_set_sbc_quality(uint8_t high);
 
+/* each device keeps its own: earbuds can take high while a car's radio plays nothing at
+ * all on it (2026-10-19). Set as a link starts, before the stack builds its config */
+static void quality_for(const uint8_t a[6])
+{
+    struct known *k = known_find(a);
+    bool hq = k && k->hq > 0;
+    bt.hq_fell_back = false;
+    bta_av_co_audio_set_sbc_quality(hq);
+    if (hq != bt.hq) {
+        bt.hq = hq;
+        changed();
+    }
+}
+
 static const char *sbc_mode_name(int ch_mode)
 {
     return ch_mode & ESP_A2D_SBC_CIE_CH_MODE_DUAL_CHANNEL ? "dual channel" :
@@ -811,6 +843,101 @@ static unsigned sbc_kbps(const esp_a2d_cie_sbc_t *c)
     return kbps;
 }
 
+/* ------------------------------------------------------------------ the link's bitrate
+ * A radio packet that doesn't get through is sent again, and again: behind a body, in a
+ * pocket at the knee, the resends take the airtime the music needed, the queue overflows
+ * and the stack throws music away -- a dropout (2026-10-19, on high). So: packets thrown
+ * away -> the bitpool a step down (smaller packets, room for the resends); a clear half
+ * minute -> a step back up, the wait doubling each time going up brought the drops back.
+ * High (dual channel) that drops falls back to standard until the next connection. */
+extern void btc_a2dp_source_coda_cap(uint8_t cap);
+extern uint8_t btc_a2dp_source_coda_top(void);
+extern uint8_t btc_a2dp_source_coda_bitpool(void);
+
+#define LR_LEVELS 4
+static const uint8_t lr_pct[LR_LEVELS] = { 100, 85, 72, 60 };   /* of the config's top bitpool */
+#define LR_FLOOR 24                                 /* ~200 kbps joint stereo at 48 kHz */
+static esp_a2d_cie_sbc_t link_cfg;
+static struct {
+    int lvl;
+    uint32_t drops0;
+    long at, quiet_since, settle_until, up_at, up_wait;
+} lr;
+
+static void link_rate_reset(void)
+{
+    lr.lvl = 0;
+    lr.up_at = 0;
+    lr.up_wait = 30 * HZ;
+    lr.quiet_since = current_tick;
+    btc_a2dp_source_coda_cap(0);
+}
+
+/* kbps at a bitpool, for the stream as configured */
+static unsigned kbps_at(uint8_t bp)
+{
+    esp_a2d_cie_sbc_t c = link_cfg;
+    c.max_bitpool = bp;
+    return sbc_kbps(&c);
+}
+
+static void link_rate_set(int lvl, const char *why, uint32_t d)
+{
+    uint8_t top = btc_a2dp_source_coda_top(), was = btc_a2dp_source_coda_bitpool();
+    uint8_t cap = lvl ? MAX(top * lr_pct[lvl] / 100, LR_FLOOR) : 0;
+    lr.lvl = lvl;
+    btc_a2dp_source_coda_cap(cap);
+    bt.live_kbps = kbps_at(cap ? MIN(cap, top) : top);
+    if (d)
+        bt_logf("link: %s (%lu dropped): bitpool %d -> %d, %u kbps", why, (unsigned long)d, was,
+                cap ? MIN(cap, top) : top, bt.live_kbps);
+    else
+        bt_logf("link: %s: bitpool %d -> %d, %u kbps", why, was, cap ? MIN(cap, top) : top, bt.live_kbps);
+    changed();
+}
+
+static void link_rate(void)
+{
+    /* not streaming, or just started (a start's first packets may queue up): nothing to judge */
+    if (st_state != ST_STARTED || st_busy || TIME_BEFORE(current_tick, st_started_at + 2 * HZ)) {
+        lr.drops0 = coda_a2dp_drops;
+        return;
+    }
+    if (!TIME_AFTER(current_tick, lr.at))
+        return;
+    lr.at = current_tick + HZ;
+    uint32_t d = coda_a2dp_drops - lr.drops0;
+    lr.drops0 = coda_a2dp_drops;
+    if (!btc_a2dp_source_coda_top())
+        return;
+    if (d) {
+        lr.quiet_since = current_tick;
+        if (TIME_BEFORE(current_tick, lr.settle_until))
+            return;                                  /* the last step is still draining */
+        if (lr.up_at && TIME_BEFORE(current_tick, lr.up_at + 20 * HZ))
+            lr.up_wait = MIN(lr.up_wait * 2, 300 * HZ);
+        lr.up_at = 0;
+        lr.settle_until = current_tick + 3 * HZ;
+        if (bt.hq && !bt.hq_fell_back) {
+            bt_logf("link: high is dropping (%lu): standard until the next connection", (unsigned long)d);
+            bt.hq_fell_back = true;
+            bta_av_co_audio_set_sbc_quality(0);
+            say("Weak signal: standard quality for now");
+            if (st_want && !st_busy) {              /* reconfigured on the way back up */
+                st_state = ST_SUSPENDING;
+                stream_cmd(ESP_A2D_MEDIA_CTRL_SUSPEND);
+            }
+            changed();
+            return;
+        }
+        if (lr.lvl < LR_LEVELS - 1)
+            link_rate_set(lr.lvl + 1, "behind", d);
+    } else if (lr.lvl > 0 && TIME_AFTER(current_tick, lr.quiet_since + lr.up_wait)) {
+        link_rate_set(lr.lvl - 1, "clear", 0);
+        lr.up_at = lr.quiet_since = current_tick;
+    }
+}
+
 /* ---- Bluedroid callbacks (BTC thread): record, then hand real work to ctl */
 
 static void inquiry_result(esp_bt_gap_cb_param_t *param)
@@ -933,6 +1060,7 @@ static void bt_app_a2d_cb(esp_a2d_cb_event_t event, esp_a2d_cb_param_t *param)
             int s = param->conn_stat.state;
             bt_logf("a2dp: %s state %d", addr_str(param->conn_stat.remote_bda), s);
             if (s == ESP_A2D_CONNECTION_STATE_CONNECTING) {
+                quality_for(param->conn_stat.remote_bda);
                 if (bt.link == BT_LINK_NONE) {      /* the headphones are calling us */
                     memcpy(bt.peer, param->conn_stat.remote_bda, 6);
                     bt.have_peer = true;
@@ -1010,7 +1138,9 @@ static void bt_app_a2d_cb(esp_a2d_cb_event_t event, esp_a2d_cb_param_t *param)
             if (param->audio_cfg.mcc.type == ESP_A2D_MCT_SBC) {
                 bt_sampr[0] = (c->samp_freq & ESP_A2D_SBC_CIE_SF_48K) ? SAMPR_48 : SAMPR_44;
                 bt.link_hz = bt_sampr[0];
-                bt.link_kbps = sbc_kbps(c);
+                bt.link_kbps = bt.live_kbps = sbc_kbps(c);
+                link_cfg = *c;
+                link_rate_reset();
                 bt_logf("a2dp: configured sbc %lu Hz %s, bitpool %d-%d (%u kbps)", bt_sampr[0],
                         sbc_mode_name(c->ch_mode), c->min_bitpool, c->max_bitpool, bt.link_kbps);
                 changed();
@@ -1438,6 +1568,7 @@ static void do_connect(const uint8_t addr[6])
     bt.msg[0] = 0;
     changed();
     bt_logf("connect: %s (%s)", addr_str(addr), name_of(addr));
+    quality_for(bt.peer);
     esp_err_t ret = esp_a2d_source_connect(bt.peer);
     if (ret != ESP_OK) {
         bt.link = BT_LINK_NONE;
@@ -1519,6 +1650,7 @@ static void housekeeping(void)
     if (bt.link >= BT_LINK_CONNECTED) {
         stream_watchdog();
         stream_ticks_watchdog();
+        link_rate();
         np_poll();
     }
     abs_save(false);
@@ -1670,6 +1802,7 @@ static void ctl_task(void)
                 }
                 break;
             case CMD_QUALITY:
+                bt.hq_fell_back = false;
                 bta_av_co_audio_set_sbc_quality(ev.data != 0);
                 bt_logf("quality: %s", ev.data ? "high (dual channel)" : "standard (joint stereo)");
                 /* streaming: stop and start again -- the link is reconfigured on the way */
@@ -1704,7 +1837,8 @@ void bluetooth_init(void)
 {
     log_open();
     state_load();
-    bta_av_co_audio_set_sbc_quality(bt.hq);
+    if (bt.have_last)
+        quality_for(bt.last);
     /* we went down with audio on Bluetooth: give wired its own volume back */
     if (bt.on_bt) {
         global_status.volume = bt.wired_volume;
@@ -1767,6 +1901,10 @@ void bt_set_scan(bool on)
 
 void bt_set_quality(bool high)
 {
+    /* the device connected's, else the last one's */
+    struct known *k = known_find(bt.have_peer && bt.link != BT_LINK_NONE ? bt.peer : bt.last);
+    if (k)
+        k->hq = high;
     bt.hq = high;
     state_save();
     changed();
@@ -1820,7 +1958,8 @@ void bt_get_status(struct bt_status *st)
     buds_get(&st->batt_l, &st->batt_r, &st->batt_case);
     st->hq = bt.hq;
     st->link_hz = bt.link >= BT_LINK_CONNECTED ? bt.link_hz : 0;
-    st->link_kbps = bt.link >= BT_LINK_CONNECTED ? bt.link_kbps : 0;
+    st->link_kbps = bt.link >= BT_LINK_CONNECTED ? bt.live_kbps : 0;
+    st->weak = bt.link >= BT_LINK_CONNECTED && (bt.hq_fell_back || lr.lvl > 0);
     st->gen = bt.gen + buds_gen;
 }
 
