 }
diff --git a/lib/bluedroid/src/btc/profile/std/a2dp/btc_a2dp_source.c b/lib/bluedroid/src/btc/profile/std/a2dp/btc_a2dp_source.c
index 88e9bfc9..8be6d9d6 100644
--- a/lib/bluedroid/src/btc/profile/std/a2dp/btc_a2dp_source.c
+++ b/lib/bluedroid/src/btc/profile/std/a2dp/btc_a2dp_source.c
@@ -720,6 +720,53 @@ static UINT16 btc_a2dp_source_rate_for_bitpool(const SBC_ENC_PARAMS *p, UINT16 f
     return rate;
 }
 
+/* coda: the link's health, for bluetooth.c's bitrate steps. coda_a2dp_drops counts
+ * media packets thrown away because the radio fell behind (the queue here overflowed, or
+ * bta_av's: bta_av_co_audio_drop); a cap on the bitpool takes effect at the next packet,
+ * inside the range the config allows (a frame says its own bitpool, so the headphones
+ * follow without a reconfigure) */
+volatile UINT32 coda_a2dp_drops;
+static volatile UINT8 coda_bp_cap;          /* 0: none */
+static UINT8 coda_bp_top, coda_bp_min;      /* where enc_update settled, the config's floor */
+
+void btc_a2dp_source_coda_cap(UINT8 cap) { coda_bp_cap = cap; }
+UINT8 btc_a2dp_source_coda_top(void) { return coda_bp_top; }
+UINT8 btc_a2dp_source_coda_bitpool(void)
+{
+    return (UINT8)a2dp_source_local_param.btc_aa_src_cb.encoder.s16BitPool;
+}
+
+static void coda_bp_settled(UINT8 min_bitpool)
+{
+    coda_bp_top = (UINT8)a2dp_source_local_param.btc_aa_src_cb.encoder.s16BitPool;
+    coda_bp_min = min_bitpool;
+}
+
+/* at a packet's start: the packing loop sizes a packet by the last frame's length, so
+ * that is set for the new bitpool too (the SBC frame length, A2DP spec 12.9) */
+static void coda_bp_apply(void)
+{
+    SBC_ENC_PARAMS *e = &a2dp_source_local_param.btc_aa_src_cb.encoder;
+    UINT8 cap = coda_bp_cap, want = coda_bp_top;
+    if (!want) {
+        return;
+    }
+    if (cap && cap < want) {
+        want = cap > coda_bp_min ? cap : coda_bp_min;
+    }
+    if (e->s16BitPool == want) {
+        return;
+    }
+    e->s16BitPool = want;
+    UINT16 sb = e->s16NumOfSubBands, blk = e->s16NumOfBlocks, ch = e->s16NumOfChannels, bits;
+    if (e->s16ChannelMode == SBC_MONO || e->s16ChannelMode == SBC_DUAL) {
+        bits = blk * ch * want;
+    } else {
+        bits = (e->s16ChannelMode == SBC_JOINT_STEREO ? sb : 0) + blk * want;
+    }
+    e->u16PacketLength = 4 + (4 * sb * ch) / 8 + (bits + 7) / 8;
+}
+
 static void btc_a2dp_source_encoder_init(void)
 {
     UINT16 minmtu;
@@ -1006,6 +1053,7 @@ static void btc_a2dp_source_enc_update(BT_HDR *p_msg)
 
         /* make sure we reinitialize encoder with new settings */
         SBC_Encoder_Init(&(a2dp_source_local_param.btc_aa_src_cb.encoder));
+        coda_bp_settled(pUpdateAudio->MinBitPool);
     }
 }
 
@@ -1423,6 +1471,7 @@ static void btc_media_aa_prep_sbc_2_send(UINT8 nb_frame)
         p_buf->offset = BTC_MEDIA_AA_SBC_OFFSET;
         p_buf->len = 0;
         p_buf->layer_specific = 0;
+        coda_bp_apply();
 
         do {
             /* Write @ of allocated buffer in encoder.pu8Packet */
@@ -1510,6 +1559,7 @@ static void btc_a2dp_source_prep_2_send(UINT8 nb_frame)
 
     while (fixed_queue_length(a2dp_source_local_param.btc_aa_src_cb.TxAaQ) > (MAX_OUTPUT_A2DP_SRC_FRAME_QUEUE_SZ - nb_frame)) {
         osi_free(fixed_queue_dequeue(a2dp_source_local_param.btc_aa_src_cb.TxAaQ, 0));
+        coda_a2dp_drops++;
     }
 
     // Transcode frame
