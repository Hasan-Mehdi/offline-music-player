-/* sound quality, remembered: high = SBC dual channel (~490 kbps; more battery, less
- * range), standard = joint stereo (~350). Playing: the stream stops and starts again */
+/* sound quality, remembered for the device connected (or the last one): high = SBC
+ * dual channel (~490 kbps; more battery, less range), standard = joint stereo (~350).
+ * Playing: the stream stops and starts again */
 void bt_set_quality(bool high);
 /* connect (pairing first if needed); audio moves to it once it's up */
 void bt_connect(const uint8_t addr[6]);
diff --git a/lib/bluedroid/src/btc/profile/std/a2dp/bta_av_co.c b/lib/bluedroid/src/btc/profile/std/a2dp/bta_av_co.c
index de09df7c..58765e12 100644
--- a/lib/bluedroid/src/btc/profile/std/a2dp/bta_av_co.c
+++ b/lib/bluedroid/src/btc/profile/std/a2dp/bta_av_co.c
@@ -1115,7 +1115,9 @@ void *bta_av_co_audio_src_data_path(tBTA_AV_CODEC codec_type, UINT32 *p_len,
  *******************************************************************************/
 void bta_av_co_audio_drop(tBTA_AV_HNDL hndl)
 {
+    extern volatile UINT32 coda_a2dp_drops;     /* coda: btc_a2dp_source.c */
     FUNC_TRACE();
+    coda_a2dp_drops++;
 
