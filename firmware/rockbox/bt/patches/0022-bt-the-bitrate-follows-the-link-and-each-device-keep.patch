 static volatile long st_tick_at, st_started_at;
 static unsigned st_short0;
+/* media packets the stack threw away, the radio behind (btc_a2dp_source.c); at the start */
+extern volatile uint32_t coda_a2dp_drops;
+static uint32_t st_drops0;
 
 static void stream_ack(int cmd, int status);
 static void they_stopped(void);    /* the headphones stopped / refused the stream: pause */
@@ -546,14 +562,16 @@ static void stream_ack(int cmd, int status)
             } else {
                 st_started_at = st_tick_at = current_tick;
                 st_short0 = st_short;
+                st_drops0 = coda_a2dp_drops;
