+/* Read exactly len bytes. timeout > 0: give up if a gap is longer than that.
+ * timeout == 0: wait for as long as it takes, unless bt_hci_disable stops us. */
+static bool hci_read_exact(uint8_t *data, size_t len, int timeout)
+{
+    size_t got = 0;
+    while (got < len) {
+        size_t n = uart_rx_tmo(PORT_UART0, data + got, len - got,
+                               timeout > 0 ? timeout : RX_POLL);
+        if (hci_stop)
+            return false;
+        if (n == 0) {
+            if (timeout > 0)
+                return false;
+            continue;   /* idle link: keep waiting */
+        }
+        got += n;
     }
