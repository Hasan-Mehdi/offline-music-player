+/* Send a command and wait for its Command Complete; false on timeout or a
+ * non-zero status. */
+static bool hci_cmd(const uint8_t *cmd, const char *what)
+{
+    uint16_t opcode = cmd[1] | (cmd[2] << 8);
+    hci_send_uart((uint8_t *)cmd, cmd[3] + 4);
+    for (int tries = 0; tries < 8; tries++) {
+        int n = hci_recv_packet(hci_rx_buf, sizeof hci_rx_buf, INIT_TIMEOUT);
+        if (n == 0)
+            break;
+        /* 04 0e len ncmd opcode(2) status */
+        if (n >= 7 && hci_rx_buf[0] == 0x04 && hci_rx_buf[1] == 0x0e &&
+            (hci_rx_buf[4] | (hci_rx_buf[5] << 8)) == opcode) {
+            if (hci_rx_buf[6] != 0) {
+                bt_logf("hci: %s failed, status %02x", what, hci_rx_buf[6]);
+                return false;
+            }
+            return true;
         }
-#endif
