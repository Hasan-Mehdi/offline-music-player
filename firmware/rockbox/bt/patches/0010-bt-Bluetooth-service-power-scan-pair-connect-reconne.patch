+#ifndef APPS_BLUETOOTH_H
+#define APPS_BLUETOOTH_H
 
-bool bt_scan(void);
-bool bt_heap_info(void);
+#include <stdbool.h>
+#include <stdint.h>
+
+enum bt_radio { BT_RADIO_OFF, BT_RADIO_STARTING, BT_RADIO_ON, BT_RADIO_FAILED, BT_RADIO_STOPPING };
+enum bt_link { BT_LINK_NONE, BT_LINK_CONNECTING, BT_LINK_CONNECTED, BT_LINK_STREAMING };
+
+#define BT_NAME_MAX 48
+
+struct bt_device {
+    uint8_t addr[6];
+    char name[BT_NAME_MAX];
+    int8_t rssi;        /* dBm, -128 = not seen this session */
+    bool paired;        /* remembered (bonded) */
+};
+
+struct bt_status {
+    int radio;          /* enum bt_radio */
+    int link;           /* enum bt_link */
+    bool scanning;
+    uint8_t peer[6];    /* the device connected or being connected to */
+    char peer_name[BT_NAME_MAX];
+    char msg[64];       /* last thing worth telling the user, "" if none */
+    unsigned gen;       /* bumps whenever any of this changes */
+};
+
+/* boot: start the radio if it was on when we shut down, reconnect */
+void bluetooth_init(void);
+/* on/off; remembered across boots */
+void bt_set_power(bool on);
+/* look for devices nearby (about 13 s, stops by itself) */
+void bt_set_scan(bool on);
+/* connect (pairing first if needed); audio moves to it once it's up */
+void bt_connect(const uint8_t addr[6]);
+void bt_disconnect(void);
+/* drop the pairing */
+void bt_forget(const uint8_t addr[6]);
+void bt_get_status(struct bt_status *st);
+/* paired devices first, then ones found nearby (strongest first) */
+int bt_get_devices(struct bt_device *out, int max);
+
+/* debug menu */
+bool bt_debug_info(void);
+
+#endif
