+
+static void state_load(void)
+{
+    bt.bt_volume = BT_VOLUME_DEFAULT;
+    bt.wired_volume = global_status.volume;
+    int fd = open(STATE_FILE, O_RDONLY);
+    if (fd < 0)
+        return;
+    char line[96];
+    while (read_line(fd, line, sizeof line) > 0) {
+        char *v = strchr(line, '=');
+        if (!v)
+            continue;
+        *v++ = 0;
+        if (!strcmp(line, "power"))
+            bt.want_power = atoi(v) != 0;
+        else if (!strcmp(line, "volume"))
+            bt.bt_volume = atoi(v);
+        else if (!strcmp(line, "wired"))
+            bt.wired_volume = atoi(v);
+        else if (!strcmp(line, "on_bt"))
+            bt.on_bt = atoi(v) != 0;
+        else if (!strcmp(line, "last"))
+            bt.have_last = parse_addr(v, bt.last);
+        else if (!strcmp(line, "dev") && bt.n_known < KNOWN_MAX) {
+            struct known *k = &bt.known[bt.n_known];
+            if (strlen(v) >= 17 && parse_addr(v, k->addr)) {
+                strlcpy(k->name, v[17] == ' ' ? v + 18 : "", sizeof k->name);
+                bt.n_known++;
+            }
         }
     }
+    close(fd);
+}
 
