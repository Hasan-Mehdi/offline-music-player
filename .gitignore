# --- Python ---
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# --- Credentials (user-supplied; never commit) ---
# ytmusicapi auth, cookies, headers, oauth tokens, etc.
auth/
*.cookies
cookies*.txt
*oauth*.json

# --- Personal data + derived artifacts ---
# listening history, seed/candidate lists, caches, csvs, etc.
data/*
# ...but keep the small tuned-weights config so the app/autoplay run out of the box
!data/autoplay_config.json
watch-history.json
*Takeout*
*.zip

# --- The music library itself (bring your own) ---
music/
*.opus
*.mp3
*.m4a
*.wav
*.flac
*.ogg
*.aac

# --- Embeddings / large binaries / model weights ---
*.npz
*.npy
*.faiss
*.parquet
*.db
*.sqlite
*.sqlite3
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.onnx
models/

# --- Generated playlists (point into a local library; regenerated by make_playlists.py) ---
viz/playlists/

# --- Vendored / cloned third-party repos (have their own git) ---
external/

# --- OS / editor noise ---
.DS_Store
Thumbs.db
.idea/
.vscode/
